# Required for product search; set this in your hosting environment.
QUICKCOMMERCE_API_KEY=replace-with-your-quickcommerce-api-key

# Optional: enables general buying tips.
GROQ_API_KEY=replace-with-your-groq-api-key

# Optional settings
GROQ_MODEL=openai/gpt-oss-20b
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
